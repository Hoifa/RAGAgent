# Mock mode requires no environment variables.
# Real mode: copy this template to .env and fill in the local key.
# The project loads root .env; shell environment variables take precedence.
# User-selected Qwen defaults. Keep your real API key out of this file.
LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen-flash
DASHSCOPE_API_KEY=
# Optional explicit key override (takes precedence over DASHSCOPE_API_KEY).
LLM_API_KEY=
LLM_ENABLE_THINKING=true
LLM_STREAM=true
# Qwen-flash thinking mode: rely on prompt + local JSON validation.
LLM_JSON_MODE=false
# auto: native functions for Qwen non-thinking; JSON actions otherwise.
LLM_ACTION_PROTOCOL=auto
# Alternative: LLM_ENABLE_THINKING=false and LLM_JSON_MODE=true.
